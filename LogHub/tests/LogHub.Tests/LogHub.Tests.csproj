<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>LogHub.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    dotnet test -p:ShowOrderProblem=true снимает [Ignore] с теста, который
    показывает зависимость классического синглтона от порядка выполнения
    (tools/show-singleton-order-problem.sh).
  -->
  <PropertyGroup Condition="'$(ShowOrderProblem)' == 'true'">
    <DefineConstants>$(DefineConstants);SHOW_ORDER_PROBLEM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LogHub\LogHub.csproj" />
  </ItemGroup>

</Project>
